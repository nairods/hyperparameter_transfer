# Copy to condor/site.env and adapt. Read by condor/run.sh and condor/submit.sh.
# Project checkout on a filesystem the batch nodes can see (EOS fuse on lxplus):
HPT_PROJECT=/eos/home-X/USER/hyperparameter_transfer
# xrootd URL of the same directory (env tarball and dataset are copied to the node with xrdcp):
HPT_XRD_BASE=root://eosuser.cern.ch//eos/user/X/USER/hyperparameter_transfer
# conda-pack tarball of the environment, relative to HPT_XRD_BASE (see README "HTCondor"):
HPT_ENV_TARBALL=env/hpt-env.tar.gz
# where condor logs/submit files go (must be AFS on lxplus, not EOS):
HPT_LOGDIR=$HOME/hpt_condor_logs
